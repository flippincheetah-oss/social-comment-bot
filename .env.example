# Copy to .env and fill in. Never share or commit .env.
ANTHROPIC_API_KEY=

# Safety: while true, replies are only logged to replies.log, never posted.
DRY_RUN=true

# Meta (Instagram + Facebook)
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_TOKEN=
META_IG_USER_ID=

# YouTube (optional; OAuth refresh token for your channel)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_CHANNEL_ID=

PORT=

# Only used by `npm run tokens`
META_APP_ID=
TEMP_USER_TOKEN=

# Optional alerts when the bot skips something that needs a human
# ntfy.sh topics are PUBLIC: anyone who guesses the name can read your alerts (they include customer messages).
# Use a long random topic (20+ random characters), or leave empty and use Telegram only.
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
